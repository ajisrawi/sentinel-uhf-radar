		(uuid "2451a83d-e956-5946-8eb4-2d711cdcceb0")
	)
	(text "2. Q2 and U3 mount through board cutouts onto the copper cold plate (liquid cooled, 45 W avg per module)."
		(exclude_from_sim no)
		(at 675 446 0)
		(effects
			(font
				(size 1.4 1.4)
			)

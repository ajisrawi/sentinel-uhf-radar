	(text "1. Matching values are first-pass from transistor large-signal models; tune at 435 MHz on load-pull bench."
		(exclude_from_sim no)
		(at 675 440 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)

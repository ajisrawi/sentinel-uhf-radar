		(uuid "6b542b69-c352-590b-8edb-8b9f3630f868")
	)
	(text "3. RF lines: 50 ohm microstrip, 1.70 mm on RO4350B 0.762 mm (L1-L2). Output path >= 3 mm wide."
		(exclude_from_sim no)
		(at 675 452 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid "b1f8f8e7-8339-54b1-9599-2db3fa866221")
	)
	(text "4. TX_EN is the only path that can turn the drain on; MCU and BIAS_OK can veto it in hardware."
